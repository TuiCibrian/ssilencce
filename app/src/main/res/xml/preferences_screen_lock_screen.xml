<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        app:icon="@drawable/ic_lock_24dp"
        app:title="@string/lock_screen_enabled_title"
        app:summary="@string/lock_screen_enabled_summary"
        app:defaultValue="false"
        app:layout="@layout/list_item_view"
        app:widgetLayout="@layout/preference_switch"
        app:key="lock_screen_player_enabled" />

    <Preference
        app:iconSpaceReserved="true"
        app:title="@string/lock_screen_preview_title"
        app:summary="@string/lock_screen_preview_summary"
        app:persistent="false"
        app:layout="@layout/list_item_view"
        app:key="lock_screen_preview" />

    <PreferenceCategory
        app:title="@string/lock_screen_behavior_header"
        app:layout="@layout/preference_category_title">

        <SwitchPreferenceCompat
            app:title="@string/lock_screen_skip_unlocked_title"
            app:summary="@string/lock_screen_skip_unlocked_summary"
            app:defaultValue="true"
            app:layout="@layout/list_item_view"
            app:widgetLayout="@layout/preference_switch"
            app:key="lock_screen_skip_when_unlocked" />

        <SwitchPreferenceCompat
            app:title="@string/lock_screen_skip_paused_title"
            app:summary="@string/lock_screen_skip_paused_summary"
            app:defaultValue="true"
            app:layout="@layout/list_item_view"
            app:widgetLayout="@layout/preference_switch"
            app:key="lock_screen_skip_when_paused" />

        <SwitchPreferenceCompat
            app:title="@string/lock_screen_gestures_title"
            app:summary="@string/lock_screen_gestures_summary"
            app:defaultValue="true"
            app:layout="@layout/list_item_view"
            app:widgetLayout="@layout/preference_switch"
            app:key="lock_screen_gestures" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/lock_screen_appearance_header"
        app:layout="@layout/preference_category_title">

        <ListPreference
            app:title="@string/lock_screen_wallpaper_title"
            app:entries="@array/pref_lock_screen_wallpaper_entries"
            app:entryValues="@array/pref_lock_screen_wallpaper_values"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="Cover"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_wallpaper" />

        <Preference
            app:title="@string/lock_screen_wallpaper_image_title"
            app:summary="@string/lock_screen_wallpaper_image_summary_none"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_wallpaper_uri" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/lock_screen_shortcuts_header"
        app:layout="@layout/preference_category_title">

        <SwitchPreferenceCompat
            app:title="@string/lock_screen_shortcuts_title"
            app:summary="@string/lock_screen_shortcuts_summary"
            app:defaultValue="true"
            app:layout="@layout/list_item_view"
            app:widgetLayout="@layout/preference_switch"
            app:key="lock_screen_shortcuts" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/lock_screen_help_header"
        app:layout="@layout/preference_category_title">

        <Preference
            app:icon="@drawable/ic_lock_open_24dp"
            app:title="@string/lock_screen_permission_guide_title"
            app:summary="@string/lock_screen_permission_guide_summary"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_permission_guide" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
