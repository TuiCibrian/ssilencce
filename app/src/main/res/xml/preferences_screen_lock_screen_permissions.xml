<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/lock_screen_permission_title"
        app:layout="@layout/preference_category_title">

        <Preference
            app:icon="@drawable/ic_lock_open_24dp"
            app:title="@string/lock_screen_overlay_title"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_overlay_permission" />

        <Preference
            app:title="@string/lock_screen_guide_steps_title_generic"
            app:persistent="false"
            app:selectable="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_oem_steps" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/lock_screen_guide_system_category"
        app:layout="@layout/preference_category_title">

        <Preference
            app:icon="@drawable/ic_notifications_24dp"
            app:title="@string/lock_screen_notification_settings_title"
            app:summary="@string/lock_screen_notification_settings_summary"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_notification_settings" />

        <Preference
            app:icon="@drawable/ic_battery_charging_full_24dp"
            app:title="@string/lock_screen_battery_guide_title"
            app:summary="@string/lock_screen_battery_guide_summary"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_battery_guide" />

        <Preference
            app:icon="@drawable/ic_settings_24dp"
            app:title="@string/lock_screen_app_settings_title"
            app:summary="@string/lock_screen_app_settings_summary"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_app_settings" />

        <Preference
            app:icon="@drawable/ic_update_24dp"
            app:title="@string/lock_screen_refresh_title"
            app:summary="@string/lock_screen_refresh_summary"
            app:persistent="false"
            app:layout="@layout/list_item_view"
            app:key="lock_screen_refresh_status" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
