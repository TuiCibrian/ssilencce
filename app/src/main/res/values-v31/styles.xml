<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Ssilencce" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="popupMenuBackground">@drawable/popupmenu_background</item>
        <item name="popupMenuStyle">@style/MaterialPopupMenuStyle</item>
        <item name="popupWindowStyle">@style/MaterialPopupMenuStyle</item>
        <item name="materialButtonStyle">@style/Widget.Ssilencce.Expressive.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Ssilencce.Expressive.Button.Tonal</item>
        <item name="homeAsUpIndicator">@drawable/ic_back_24dp</item>
    </style>

    <style name="Base.Theme.Ssilencce.Light" parent="Theme.Material3Expressive.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="popupMenuBackground">@drawable/popupmenu_background</item>
        <item name="popupMenuStyle">@style/MaterialPopupMenuStyle</item>
        <item name="popupWindowStyle">@style/MaterialPopupMenuStyle</item>
        <item name="materialButtonStyle">@style/Widget.Ssilencce.Expressive.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Ssilencce.Expressive.Button.Tonal</item>
        <item name="homeAsUpIndicator">@drawable/ic_back_24dp</item>
    </style>

    <style name="Base.Theme.Ssilencce.Adaptive" parent="@style/Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="popupMenuBackground">@drawable/popupmenu_background</item>
        <item name="popupMenuStyle">@style/MaterialPopupMenuStyle</item>
        <item name="popupWindowStyle">@style/MaterialPopupMenuStyle</item>
        <item name="materialButtonStyle">@style/Widget.Ssilencce.Expressive.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Ssilencce.Expressive.Button.Tonal</item>
        <item name="homeAsUpIndicator">@drawable/ic_back_24dp</item>
    </style>

    <style name="Theme.Ssilencce.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo_splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background_color</item>
    </style>

    <style name="Theme.AppWidget" parent="@style/Theme.Material3Expressive.DynamicColors.DayNight"/>

</resources>