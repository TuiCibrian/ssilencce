    <!-- Battery & background OEM guide -->
    <string-array name="battery_guide_steps_xiaomi">
        <item>1. Open Settings → Apps → Manage apps → ssilencce.</item>
        <item>2. Tap Battery saver and choose No restrictions.</item>
        <item>3. Return to the app info screen, tap Autostart and enable ssilencce.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap the lock icon.</item>
    </string-array>

    <string-array name="battery_guide_steps_huawei">
        <item>1. Open Settings → Battery → App launch.</item>
        <item>2. Find ssilencce and turn off Manage automatically.</item>
        <item>3. Enable Auto-launch, Secondary launch and Run in background.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap the lock icon.</item>
    </string-array>

    <string-array name="battery_guide_steps_samsung">
        <item>1. Open Settings → Battery → Background usage limits.</item>
        <item>2. Remove ssilencce from Sleeping apps and Deep sleeping apps.</item>
        <item>3. Add ssilencce to Never sleeping apps.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap Keep open.</item>
    </string-array>

    <string-array name="battery_guide_steps_oppo">
        <item>1. Open Settings → Battery → App battery management → ssilencce.</item>
        <item>2. Allow background activity.</item>
        <item>3. Open Settings → Apps → Auto-launch and enable ssilencce.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap the lock icon.</item>
    </string-array>

    <string-array name="battery_guide_steps_realme">
        <item>1. Open Settings → Battery → App battery management → ssilencce.</item>
        <item>2. Allow background activity and turn off Smart power saving for the app.</item>
        <item>3. Open Settings → Apps → Auto-launch and enable ssilencce.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap the lock icon.</item>
    </string-array>

    <string-array name="battery_guide_steps_vivo">
        <item>1. Open Settings → Battery → Background power consumption management.</item>
        <item>2. Find ssilencce and allow high background power consumption.</item>
        <item>3. Open iManager → App manager → Autostart and enable ssilencce.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap the lock icon.</item>
    </string-array>

    <string-array name="battery_guide_steps_asus">
        <item>1. Open Settings → Battery → Battery optimization.</item>
        <item>2. Find ssilencce and choose Not optimized.</item>
        <item>3. In Mobile Manager, allow ssilencce to auto-start and keep running.</item>
        <item>4. Open Recents, long-press the ssilencce card and tap the lock icon.</item>
    </string-array>

    <string-array name="battery_guide_steps_generic">
        <item>1. Open Settings → Apps → ssilencce → Battery.</item>
        <item>2. Choose Unrestricted or turn off battery optimization for the app.</item>
        <item>3. Open Recents, long-press the ssilencce card and pin or lock it if your launcher allows it.</item>
    </string-array>

