<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Ssilencce" parent="Base.Theme.Ssilencce"/>

    <style name="Theme.Ssilencce.Light" parent="Base.Theme.Ssilencce.Light"/>

    <style name="Theme.Ssilencce.Black" parent="Base.Theme.Ssilencce.Black"/>

    <style name="Theme.Ssilencce.FollowSystem" parent="Base.Theme.Ssilencce.Adaptive"/>

    <style name="Theme.Ssilencce.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo_splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background_color</item>
    </style>

    <style name="Widget.Ssilencce.Expressive.Button" parent="Widget.Material3Expressive.Button">
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Ssilencce.Expressive.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="iconGravity">textStart</item>
    </style>

    <style name="HomeActionButton" parent="Widget.Material3Expressive.Button">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lines">2</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="backgroundTint">?colorSurfaceContainerLow</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconPadding">16dp</item>
        <item name="iconTint">?colorOnSurface</item>
    </style>

    <style name="PlayerIconButton" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?colorOnSurface</item>
        <item name="rippleColor">?colorControlHighlight</item>
    </style>

    <style name="PlayerIconButton.Medium">
        <item name="iconSize">32dp</item>
    </style>

    <style name="PlayerIconButton.Large">
        <item name="iconSize">64dp</item>
    </style>

    <style name="SearchChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:checked">false</item>
        <item name="android:textSize">16sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">10dp</item>
    </style>

    <style name="MenuButtonStyle" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:focusable">false</item>
        <item name="icon">@drawable/ic_more_vert_24dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="android:maxWidth">@null</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
        <item name="backgroundTint">@color/aurora_glass_fill</item>
    </style>

    <style name="Widget.Ssilencce.Aurora.NavigationBar" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/aurora_nav_bar_background</item>
        <item name="android:elevation">8dp</item>
        <item name="itemIconTint">@color/aurora_nav_item_color</item>
        <item name="itemTextColor">@color/aurora_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Ssilencce.Aurora.NavigationBar.ActiveIndicator</item>
    </style>

    <style name="Widget.Ssilencce.Aurora.NavigationBar.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/aurora_accent_tint_strong</item>
    </style>

    <style name="Widget.Ssilencce.Aurora.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="android:background">@color/aurora_glass_fill</item>
        <item name="itemIconTint">@color/aurora_nav_item_color</item>
        <item name="itemTextColor">@color/aurora_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Ssilencce.Aurora.NavigationRail.ActiveIndicator</item>
    </style>

    <style name="Widget.Ssilencce.Aurora.NavigationRail.ActiveIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:color">@color/aurora_accent_tint_strong</item>
    </style>

    <style name="AuroraMiniPlayButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="backgroundTint">@color/aurora_play_button_fill</item>
        <item name="iconTint">@color/aurora_play_button_icon</item>
        <item name="rippleColor">@color/aurora_play_button_icon</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="AuroraMiniIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="iconTint">?colorOnSurfaceVariant</item>
    </style>

    <style name="AuroraGridPlayButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="backgroundTint">@color/aurora_play_button_fill</item>
        <item name="iconTint">@color/aurora_play_button_icon</item>
        <item name="rippleColor">@color/aurora_play_button_icon</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="AuroraDetailIconButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?colorOnSurfaceVariant</item>
    </style>

    <style name="AuroraWavyPlayButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">62dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/aurora_play_button_fill</item>
        <item name="iconTint">@color/aurora_play_button_icon</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="rippleColor">@color/aurora_play_button_icon</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="AuroraPillPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="backgroundTint">@color/aurora_play_button_fill</item>
        <item name="iconTint">@color/aurora_play_button_icon</item>
        <item name="android:textColor">@color/aurora_play_button_icon</item>
        <item name="rippleColor">@color/aurora_play_button_icon</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="AuroraPillSecondaryButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="backgroundTint">?colorSurfaceContainerHigh</item>
        <item name="iconTint">?colorOnSurfaceVariant</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="strokeColor">@color/aurora_hairline_dim</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AuroraSecGoButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?colorOnSurfaceVariant</item>
    </style>



    <style name="ModalBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?colorSurfaceContainer</item>
        <item name="shapeAppearance">?shapeAppearanceCornerLarge</item>
    </style>

    <style name="ModalBottomSheetStyle.EdgeToEdge">
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="CircularShapeAppearance" parent="">
        <item name="cornerSize">50%</item>
        <item name="cornerFamily">rounded</item>
    </style>

</resources>
